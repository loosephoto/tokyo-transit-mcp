{
  "name": "tokyo-transit-mcp",
  "version": "2.38.4",
  "description": "Tokyo public transportation API MCP server - ODPT, Tokyo Metro, Toei, JR East",
  "type": "module",
  "main": "src/index.mjs",
  "bin": {
    "tokyo-transit-mcp": "./src/index.mjs"
  },
  "scripts": {
    "build": "node --check src/index.mjs",
    "test": "node scripts/probe-all-lang.mjs",
    "test:walk": "node scripts/test-walk-transfer-stations.mjs",
    "test:bus": "node scripts/probe-bus-transfer-lang.mjs && node scripts/test-bus-routes-expansion.mjs",
    "test:vehicle": "node scripts/probe-bus-vehicle-mock.mjs",
    "start": "node src/index.mjs",
    "dev": "node src/index.mjs"
  },
  "keywords": [
    "mcp",
    "transit",
    "tokyo",
    "public-transport",
    "odpt",
    "tokyo-metro",
    "toei",
    "jreast"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.4.0",
    "axios": "^1.6.0",
    "adm-zip": "^0.5.10",
    "dotenv": "^16.0.0"
  }
}